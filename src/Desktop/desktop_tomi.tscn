[sub_resource type="Resource" id="Pista_guion_1"]
script = ExtResource("pista")
id = "guion_kaiser"
tipo = 3
titulo = "Kaiser y sus capturas"
texto = "Tomás anotó que si Kaiser vuelve a tirar hate lo va a exponer en vivo con capturas guardadas."

[sub_resource type="Resource" id="Pista_guion_2"]
script = ExtResource("pista")
id = "guion_sponsor"
tipo = 0
puntos = 2
titulo = "No mencionar lo del sponsor"
texto = "Tomás escribió que no hable del sponsor y que, si preguntan por Volt, cambie de tema. Lucas le dice que \"se arregla\"."

[sub_resource type="Resource" id="Pista_guion_3"]
script = ExtResource("pista")
id = "guion_minecraft"
tipo = 1
titulo = "Su primer stream"
texto = "El primer stream de Tomás fue de Minecraft, en 2019, con tres viewers."

[sub_resource type="Resource" id="Pista_guion_4"]
script = ExtResource("pista")
id = "guion_fortnite"
tipo = 3
titulo = "El año que explotó"
texto = "Tomás explotó en 2020, con Fortnite."

[sub_resource type="Resource" id="Pista_guion_5"]
script = ExtResource("pista")
id = "guion_madrugar"
tipo = 0
puntos = 1
titulo = "Madrugar el martes"
texto = "Tomás anotó que cierra temprano porque el martes tiene que madrugar."

[sub_resource type="Resource" id="Pista_guion_6"]
script = ExtResource("pista")
id = "guion_chusmeo"
tipo = 2
titulo = "Chusmeo"
texto = "Tomás avisa en Chusmeo cuando no hay stream."

