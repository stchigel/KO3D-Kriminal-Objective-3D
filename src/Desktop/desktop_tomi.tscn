[node name="Guion" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "GUION STREAM LUNES — \"ESPECIAL 100K\"\n\nARRANQUE (22:00)\n- Saludar a los Frosties del Discord. Nombrar a los mods (Juanchi, Belu, el Tano) que la vienen remando.\n- Agradecer los 100K. No llorar. Bueno, un poquito sí, queda bien.\n- [url=guion_kaiser]Si Kaiser vuelve a tirar hate, lo expongo en vivo.[/url] Tengo las capturas guardadas.\n\nBLOQUE 1 — SORTEO\n- Sorteo de la silla gamer. Revisar que el bot del sorteo ande, la última vez ganó una cuenta de 2 días.\n- [url=guion_sponsor]NO mencionar lo del sponsor, Lucas dice que se arregla.[/url] Si alguien pregunta por Volt, cambiar de tema.\n\nBLOQUE 2 — ANÉCDOTAS\n- Contar la de siempre: mi primer stream fue de [url=guion_minecraft]Minecraft, en 2019[/url], con tres viewers (mi vieja, Flor y Lucas). Mi vieja preguntó en el chat si ya había comido.\n- Recordar: [url=guion_fortnite]el año que exploté fue 2020, con Fortnite.[/url] Mostrar el clip del 1v4.\n- Si el chat pide, contar lo del corte de luz en el torneo. No contar lo del baño.\n\nCIERRE\n- Cerrar temprano, [url=guion_madrugar]mañana martes tengo que madrugar.[/url]\n- Subir el VOD a FrostCloud después del stream, que la otra vez se me borró.\n- Avisar en [url=guion_chusmeo]Chusmeo[/url] que mañana no hay stream. Inventar algo creíble.\n- Dejar a Rocco en lo de Flor antes del martes. IMPORTANTE."
nombre = "guion_ultimo_stream.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_guion_1"), SubResource("Pista_guion_2"), SubResource("Pista_guion_3"), SubResource("Pista_guion_4"), SubResource("Pista_guion_5"), SubResource("Pista_guion_6")])

