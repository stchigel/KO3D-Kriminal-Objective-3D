[node name="ChatAbril" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "Dana: Abriii\nDana: ¿Mañana cumplís dos años con Matías, no? [url=dana_aniversario]21 de agosto[/url], lo tengo anotado jaja\nAbril: Síiii 🥹 Me hizo reservar en el lugar de sushi caro, el de la esquina de Rivadavia.\nDana: Uuuh, se viene anillo\nAbril: Callate jajaja\nAbril: Che, [url=dana_llaves]le presté mis llaves el jueves[/url] porque se le rompió el celu y tenía que esperar al técnico acá. Me las devolvió a la noche, no te asustes.\nDana: Mmm ok. Avisale a Lu igual, que ya sabés cómo se pone con el cuadro.\nAbril: Sí sí, igual solo estuvo en el living.\nDana: [url=dana_sabado]Yo el sábado no estoy en todo el día[/url], me voy a lo de mi vieja a Moreno.\nAbril: Tranqui, él es re responsable.\nDana: Bueno, pero la pizza del viernes la pagás vos."
nombre = "chat_abril.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_ChatAbril_1"), SubResource("Pista_ChatAbril_2"), SubResource("Pista_ChatAbril_3")])

[node name="Tarjeta" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "BANCO — RESUMEN DE TARJETA — DANA RÍOS\n\nConsumos del período: Supermercado, Plataforma de música, Entradas recital, Farmacia, Delivery (x9)\nSaldo adeudado: [url=tarjeta_saldo]$480.000[/url]\n[url=tarjeta_minimo]Pago mínimo vencido[/url]\nPróximo vencimiento: 28/11"
nombre = "resumen_tarjeta.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_Tarjeta_1"), SubResource("Pista_Tarjeta_2")])

[node name="NotasAbril" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "Cosas para no olvidarme:\n– Turno dentista jueves 17 hs\n– Devolverle a Dani el cargador\n– Comprar regalo para Lu\n\nIdeas de regalo para Lu:\n– Libro de acuarela (el de tapa azul que vio en la feria)\n– Entradas para alguna muestra\n– Un marco lindo para sus dibujos chiquitos\n\nLu me contó el otro día, mientras cocinábamos, que su primera muestra se llamó [url=abril_sal_de_mar]Sal de mar[/url], re poético. La hizo en un bar de San Telmo con doce cuadros y vinieron solo sus viejos y dos amigas. Se reía contándolo. La que la hizo conocida fue [url=abril_agua_quieta]Agua quieta[/url], la del año pasado."
nombre = "notas.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_NotasAbril_1"), SubResource("Pista_NotasAbril_2")])

[node name="NotasLucia" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "CUADROS 2025\n\n\"Agua quieta nº 3\" — óleo sobre tela, 80 × 60. Lo terminé en octubre, después de cuatro meses. Es el mejor que hice. Todavía me da un poco de pena venderlo, pero con eso pago el alquiler de un año y el taller.\n\n[url=lucia_sin_venta]No lo subí a ninguna página de venta.[/url] No quiero que ande dando vueltas por internet. La única foto está en [url=lucia_lienzo]mi Lienzo[/url], y ni siquiera se ve entero. Solo lo sabe la galería y los que vinieron a casa a verlo: las chicas, mis viejos, Mati (el novio de Abri) y el profe Julio.\n\nPendientes:\n– Comprar bastidores\n– [url=lucia_luz_pasillo]Pedirle a Omar que arregle la luz del pasillo[/url], que me da miedo subir de noche\n– Terminar la serie de acuarelas para el parcial"
nombre = "notas_lucia.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_NotasLucia_1"), SubResource("Pista_NotasLucia_2"), SubResource("Pista_NotasLucia_3")])

[connection signal="pressed" from="Topbar/Desconectar" to="." method="_on_desconectar_pressed"]
