titulo = "Primera muestra de Lucía"
texto = "La primera muestra de Lucía se llamó Sal de mar. Probá ese nombre como clave."

[sub_resource type="Resource" id="Pista_NotasAbril_2"]
script = ExtResource("pista")
id = "abril_agua_quieta"
tipo = 3
titulo = "Agua quieta, la muestra conocida"
texto = "Según Abril, la que hizo conocida a Lucía fue Agua quieta, la del año pasado."

[sub_resource type="Resource" id="Pista_NotasLucia_1"]
script = ExtResource("pista")
id = "lucia_sin_venta"
tipo = 0
puntos = 1
titulo = "El cuadro nunca estuvo a la venta online"
texto = "Lucía no subió Agua quieta nº 3 a ninguna página de venta: la única foto, incompleta, está en su Lienzo."

[sub_resource type="Resource" id="Pista_NotasLucia_2"]
