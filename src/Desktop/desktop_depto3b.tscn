[node name="Reglas" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "REGLAS OFICIALES DEL 3B\nVersión 4 (la 3 se perdió cuando Dani derramó mate en la compu)\nFirmado: Lu, Abri, Dani\n\n1. La compu es de las tres, cada una con su usuario. Invitado es para visitas, novios y el primo de Dani que viene a imprimir cosas.\n\n2. [url=reglas_visitas]Nadie trae gente a dormir sin avisar.[/url] Con un mensaje en el grupo alcanza. \"Ya está acá\" no cuenta como aviso.\n\n3. [url=reglas_omar]Omar tiene copia de todas las llaves[/url], así que si se olvidan la suya, toquen en portería. Llévenle algo, que siempre nos salva.\n\n4. La cámara del living es para cuando no hay nadie, por los robos del edificio. La app de la cámara está en el usuario Invitado. [url=reglas_camara]Se mueve con las flechitas.[/url]\n\n5. [url=reglas_expensas]Dani nos debe dos meses de expensas[/url] (esto va en serio, Dani, lo firmaste).\n\n6. Los viernes se pide pizza. Sin excepción. Ni por parciales.\n\n7. El cuadro grande de Lu NO se toca, NO se apoya nada contra la pared y NO se le pasa el plumero. Lu lo limpia sola.\n\n8. El que termina el papel higiénico lo repone. Sí, Abri, vos."
nombre = "reglas_depto.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_Reglas_1"), SubResource("Pista_Reglas_2"), SubResource("Pista_Reglas_3"), SubResource("Pista_Reglas_4")])

