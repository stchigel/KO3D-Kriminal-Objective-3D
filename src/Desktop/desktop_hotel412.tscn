[sub_resource type="Resource" id="Pista_nov_1"]
script = ExtResource("pista")
id = "nov_salas_no_molestar"
tipo = 0
puntos = 1
titulo = "Salas pidió no ser molestado"
texto = "A las 22:40 Salas pidió no ser molestado, dejó un sobre nuevo en custodia y preguntó dos veces quién estaba de gerente esa noche."

[sub_resource type="Resource" id="Pista_nov_2"]
script = ExtResource("pista")
id = "nov_rocio_llave"
tipo = 3
titulo = "Rocío pidió la llave maestra"
texto = "A las 23:00 Rocío pidió la llave maestra para reponer los minibares del piso 4 y la devolvió a las 23:30."

[sub_resource type="Resource" id="Pista_nov_3"]
script = ExtResource("pista")
id = "nov_reloj_atrasa"
tipo = 0
puntos = 1
titulo = "El reloj del sistema atrasa"
texto = "A las 00:15 el recepcionista anotó que el reloj del sistema sigue atrasando y que tiene que corregir la hora a mano en cada ticket."

[sub_resource type="Resource" id="Pista_nov_4"]
script = ExtResource("pista")
id = "nov_clave_pms"
tipo = 1
titulo = "Clave del sistema de reservas"
texto = "La clave del sistema de reservas es el número de la suite presidencial más las iniciales del gerente nocturno."

[sub_resource type="Resource" id="Pista_nov_5"]
script = ExtResource("pista")
id = "nov_web_hotel"
tipo = 2
titulo = "Web del hotel"
texto = "Los datos para recordar la clave están en la web del hotel."

