[node name="Novedades" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "LIBRO DE NOVEDADES — TURNO NOCHE — MIÉRCOLES 22/10\n\n21:05 — Recibo el turno. Ocupación 78 %. Pendientes del turno tarde: la 305 llega tarde (vuelo demorado), la 210 pidió almohada extra.\n\n21:30 — Se entrega almohada a la 210. Se queja del ruido del ascensor. Se le ofrece cambio, no acepta.\n\n22:10 — Grupo de congresistas vuelve de la cena. Mucho ruido en el lobby. Se pide silencio con buenos modos.\n\n22:40 — El Sr. Salas (412) [url=nov_salas_no_molestar]pide no ser molestado. Deja un sobre nuevo en custodia, cerrado y firmado. Lo noto de mal humor, pregunta dos veces quién está de gerente esta noche.[/url]\n\n23:00 — Rocío pide [url=nov_rocio_llave]la llave maestra[/url] para reponer los minibares del piso 4.\n\n23:30 — Rocío devuelve la llave. Avisa que la luz del pasillo del 4 parpadea.\n\n00:15 — El reloj del sistema sigue atrasando. Se lo avisé a mantenimiento otra vez. [url=nov_reloj_atrasa]Cada vez que hago un check-in tengo que corregir la hora a mano en el ticket.[/url]\n\n00:20 — Para el que viene mañana, porque siempre me preguntan: la clave del sistema de reservas es la de siempre, [url=nov_clave_pms]número de la suite presidencial + iniciales del gerente nocturno.[/url] Si no se acuerdan de alguno, está todo en [url=nov_web_hotel]la web del hotel[/url]. No la anoten en un post-it, por favor.\n\n00:45 — Gato en la puerta del estacionamiento. Otra vez. Le di jamón. No le digan a gerencia.\n\n01:00 — Sin novedades. Todo tranquilo.\n\n02:00 — Llega la 305. Check-in sin problemas.\n\n— Recepción, turno noche"
nombre = "novedades_turno_noche.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_nov_1"), SubResource("Pista_nov_2"), SubResource("Pista_nov_3"), SubResource("Pista_nov_4"), SubResource("Pista_nov_5")])

