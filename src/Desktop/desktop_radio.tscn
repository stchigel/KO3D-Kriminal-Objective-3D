[node name="Registro" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 320.0
offset_top = 168.0
offset_right = 640.0
offset_bottom = 616.0
texto = "REGISTRO DE ARCHIVOS — CARPETA AUDIOS — SEMANA 03/11 AL 07/11\n\ncortina_violines.mp3 — creado: 12/03/2019 — usuario: hlema\nbloque_miercoles.mp3 — creado: miércoles 20:55 — usuario: vcastro\nbloque_jueves.mp3 — creado: jueves 21:10 — usuario: nsuarez\n[url=registro_tano]tanda_eltano.mp3 — creado: viernes 19:00 — usuario: nsuarez[/url]\n[url=registro_bloque_viernes]bloque_viernes.mp3 — creado: viernes 20:47 — usuario: vcastro[/url]\ncolumna_horacio_0611.mp3 — creado: jueves 18:30 — usuario: hlema"
nombre = "registro_archivos.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_reg_1"), SubResource("Pista_reg_2")])

[node name="Transcripcion" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 352.0
offset_top = 184.0
offset_right = 672.0
offset_bottom = 632.0
texto = "Buenas noches, vecinos, bienvenidos a La Trasnoche, como todos los viernes. [url=transcripcion_sol]¡Qué hermoso sol tuvimos hoy![/url] Da gusto salir a la vereda con un día así, ¿no? Se nota que la primavera llegó para quedarse.\n\nArrancamos con [url=transcripcion_saludos]los saludos de siempre[/url], que [url=transcripcion_muro]el muro de la web[/url] ya está explotando. Un beso grande para Chela de Villa Bosch, para Rubén de Caseros, para la señora del kiosco…\n\n(el audio tiene un pequeño corte, como si estuviera pegado de dos grabaciones distintas)"
nombre = "transcripcion_bloque_viernes.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_trans_1"), SubResource("Pista_trans_2"), SubResource("Pista_trans_3")])

