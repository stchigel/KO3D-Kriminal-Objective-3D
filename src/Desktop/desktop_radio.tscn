[sub_resource type="Resource" id="Pista_pauta_1"]
script = ExtResource("pista")
id = "pauta_clima"
tipo = 0
puntos = 2
titulo = "Horacio abre con el clima"
texto = "Horacio siempre abre el programa hablando del clima. Es su marca. Si llueve, deja la ventana abierta para que se escuche."

[sub_resource type="Resource" id="Pista_pauta_2"]
script = ExtResource("pista")
id = "pauta_tano"
tipo = 3
titulo = "Avisos de El Tano"
texto = "Tres avisos de Corralón El Tano en la primera tanda. Hay que cobrarlos este mes porque ya deben dos."

[sub_resource type="Resource" id="Pista_pauta_3"]
script = ExtResource("pista")
id = "pauta_vera_audios"
tipo = 0
puntos = 2
titulo = "Vera sube los bloques grabados"
texto = "Los bloques grabados los sube Vera a la carpeta de Audios."

[sub_resource type="Resource" id="Pista_pauta_4"]
script = ExtResource("pista")
id = "pauta_web"
tipo = 2
titulo = "La web de la radio"
texto = "Nico tiene que actualizar la grilla en la web de la radio. Mirá la web para ver cómo quedó."

[sub_resource type="Resource" id="Pista_pauta_5"]
script = ExtResource("pista")
id = "pauta_nico_listo"
tipo = 3
titulo = "Nico deja todo listo"
texto = "Nico cierra la radio a las 21 y deja todo listo para que Horacio arranque solo."

[sub_resource type="Resource" id="Pista_reg_1"]
script = ExtResource("pista")
id = "registro_tano"
tipo = 3
titulo = "Tanda de El Tano"
texto = "La tanda de El Tano la cargó Nico el viernes a las 19:00."

[sub_resource type="Resource" id="Pista_reg_2"]
script = ExtResource("pista")
id = "registro_bloque_viernes"
tipo = 4
puntos = 5
titulo = "El bloque del viernes lo subió Vera"
texto = "El archivo bloque_viernes.mp3 fue creado el viernes a las 20:47 por el usuario vcastro, diecisiete minutos después de la cita con Horacio."

[sub_resource type="Resource" id="Pista_trans_1"]
script = ExtResource("pista")
id = "transcripcion_sol"
tipo = 0
puntos = 3
titulo = "Horacio habla de sol"
texto = "En el audio del viernes Horacio habla de un hermoso sol, pero ese día llovió en todo el barrio. Horacio nunca mentía con el clima."

[sub_resource type="Resource" id="Pista_trans_2"]
script = ExtResource("pista")
id = "transcripcion_saludos"
tipo = 3
titulo = "Los saludos de siempre"
texto = "El audio arranca con los saludos de siempre a los oyentes del muro."

[sub_resource type="Resource" id="Pista_trans_3"]
script = ExtResource("pista")
id = "transcripcion_muro"
tipo = 2
titulo = "El muro de la web"
texto = "El audio menciona el muro de la web. Mirá qué escribieron los oyentes esa noche."

