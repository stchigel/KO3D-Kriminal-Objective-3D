[node name="Pauta" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "LA TRASNOCHE — PAUTA VIERNES 07/11 — 22 A 24 HS\n\n22:00 — APERTURA\nCortina de siempre (la de los violines, NO la nueva que no le gusta a nadie).\n[url=pauta_clima]Horacio siempre abre hablando del clima.[/url] Es su marca, no tocar. Si llueve, deja la ventana abierta para que se escuche.\n\n22:15 — SALUDOS\nLeer los mensajes del muro. Priorizar a los de siempre: Chela de Villa Bosch, Rubén de Caseros, la señora del kiosco de la estación.\n\n22:40 — TANDA 1\nTres avisos de [url=pauta_tano]Corralón El Tano[/url] (cobrar este mes sin falta, ya deben dos).\nUn aviso de la pizzería La Esquina.\n\n23:00 — COLUMNA\nHoracio lee la columna de la semana. La sube el día anterior a su blog, así los oyentes pueden comentarla.\n\n23:30 — MÚSICA\nTres temas de la lista de Horacio. Nada de reggaetón, que después llaman para quejarse.\n\nOPERACIÓN\n[url=pauta_vera_audios]Los bloques grabados los sube Vera[/url] a la carpeta de Audios.\nNico: actualizar la grilla nueva en [url=pauta_web]la web de la radio[/url], que sigue apareciendo La Siesta de los martes y ya no existe.\nOperación técnica: Nico. Nico cierra la radio a las 21 y [url=pauta_nico_listo]deja todo listo[/url] para que Horacio arranque solo."
nombre = "pauta_programa.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_pauta_1"), SubResource("Pista_pauta_2"), SubResource("Pista_pauta_3"), SubResource("Pista_pauta_4"), SubResource("Pista_pauta_5")])

