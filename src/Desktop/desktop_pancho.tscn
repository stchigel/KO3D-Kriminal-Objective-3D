[node name="Carta" parent="." instance=ExtResource("texto_scene")]
visible = false
layout_mode = 0
offset_left = 288.0
offset_top = 152.0
offset_right = 608.0
offset_bottom = 600.0
texto = "Julián:\n\nTe escribo porque por teléfono no me dejás terminar una frase, y cuando venís estás tan apurado que no te sacás ni la campera. Así que va por escrito, como se hacía antes, que para algo tu tía fue maestra treinta y dos años.\n\nYa sé lo que me vas a decir. Que la casa es grande, que la escalera, que a mi edad, que un día me voy a caer y nadie se va a enterar. Me lo repetís tanto que ya parece una promesa. Pero esta casa la levantamos con tu tío ladrillo por ladrillo, los fines de semana, cuando vos todavía ni habías nacido. En el marco de la puerta de la cocina siguen las rayitas donde te medíamos en cada cumpleaños. Así que te lo digo clarito, para que no queden dudas: [url=carta_no_vender]no pienso venderla, ni ahora ni nunca[/url].\n\nTampoco estoy tan sola como creés. Tengo a [url=carta_pancho]Pancho[/url], que desde que [url=carta_llegada_pancho]llegó a casa un 14 de marzo[/url], flaco y con una oreja mordida, no se me despega ni para ir al baño. Duerme en el tercer escalón, que es el único donde da el sol a la tarde, y cada vez que bajo me tengo que acordar de pasarle por arriba. Y me paso las tardes en [url=carta_gateros]Gateros del Oeste[/url], el foro ese que me mostraste vos, charlando con gente que por lo menos me pregunta cómo estoy antes de preguntarme por los papeles.\n\nLo único que me altera los nervios es [url=carta_ruiz]Ruiz, el de al lado, con la música a todo volumen; un día lo mato[/url]. Pone tangos a las once de la noche, y no de los lindos. Y Sonia, que viene tres veces por semana y [url=carta_sonia]me cambia todas las cosas de lugar[/url]: el azúcar arriba, los remedios abajo, las tijeras quién sabe dónde. Aunque es buena chica y me hace reír, que a esta altura no es poco.\n\nEl [url=carta_cumple]2 de junio cumplo 68[/url] y me gustaría que vengas a comer. Hago los canelones de tu abuela, los que te gustaban cuando eras chico y te manchabas la remera entera de salsa. Pero vení a comer, Julián. A comer, no a traerme papeles.\n\nTu tía que te quiere, aunque no parezca,\n\nMarta\n\nP.D.: Pancho te manda saludos. Mentira, no te quiere mucho. Pero yo sí."
nombre = "carta_sin_enviar.txt"
pistas = Array[ExtResource("pista")]([SubResource("Pista_carta_1"), SubResource("Pista_carta_2"), SubResource("Pista_carta_3"), SubResource("Pista_carta_4"), SubResource("Pista_carta_5"), SubResource("Pista_carta_6"), SubResource("Pista_carta_7")])

