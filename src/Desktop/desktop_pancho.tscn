[sub_resource type="Resource" id="Pista_carta_1"]
script = ExtResource("pista")
id = "carta_no_vender"
tipo = 0
puntos = 2
titulo = "No piensa vender la casa"
texto = "Marta le dijo por escrito a Julián que no vende la casa, ni ahora ni nunca."

[sub_resource type="Resource" id="Pista_carta_2"]
script = ExtResource("pista")
id = "carta_pancho"
tipo = 1
titulo = "Su compañero"
texto = "Pancho, el gato que no se le despega a Marta."

[sub_resource type="Resource" id="Pista_carta_3"]
script = ExtResource("pista")
id = "carta_llegada_pancho"
tipo = 1
titulo = "Llegada de Pancho"
texto = "Pancho llegó a la casa de Marta un 14 de marzo."

[sub_resource type="Resource" id="Pista_carta_4"]
script = ExtResource("pista")
id = "carta_gateros"
tipo = 2
titulo = "Gateros del Oeste"
texto = "Marta pasa las tardes en este foro de gateros, que le mostró Julián."

[sub_resource type="Resource" id="Pista_carta_5"]
script = ExtResource("pista")
id = "carta_ruiz"
tipo = 3
titulo = "Ruiz y su música"
texto = "Marta escribió que a Ruiz, el vecino, \"un día lo mato\" por la música a todo volumen."

[sub_resource type="Resource" id="Pista_carta_6"]
script = ExtResource("pista")
id = "carta_sonia"
tipo = 3
titulo = "Sonia cambia las cosas"
texto = "Sonia, la cuidadora, le cambia todas las cosas de lugar."

[sub_resource type="Resource" id="Pista_carta_7"]
script = ExtResource("pista")
id = "carta_cumple"
tipo = 3
titulo = "Cumpleaños de Marta"
texto = "Marta cumple 68 el 2 de junio."

