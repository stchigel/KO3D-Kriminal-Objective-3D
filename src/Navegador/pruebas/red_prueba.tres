[ext_resource type="Script" uid="uid://gajm70a1rinc" path="res://src/Navegador/Social/perfil_social.gd" id="2_perfil"]
[ext_resource type="Script" uid="uid://uwsb26kps6yt" path="res://src/Navegador/Social/publicacion.gd" id="3_publicacion"]
