[gd_scene format=3]

[ext_resource type="Script" path="res://src/Navegador/Social/comentario_social.gd" id="1_comentario"]
[ext_resource type="Script" path="res://src/Navegador/Social/boton_autor.gd" id="2_autor"]
[ext_resource type="Script" path="res://src/Navegador/Social/texto_resaltable.gd" id="3_texto"]

[node name="ComentarioSocial" type="PanelContainer"]
script = ExtResource("1_comentario")

[node name="Contenido" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Autor" type="Button" parent="Contenido"]
layout_mode = 2
size_flags_horizontal = 0
theme_override_font_sizes/font_size = 14
flat = true
script = ExtResource("2_autor")

[node name="Texto" type="RichTextLabel" parent="Contenido"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
fit_content = true
scroll_active = false
script = ExtResource("3_texto")
