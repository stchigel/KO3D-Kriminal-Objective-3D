vertical_alignment = 1

[node name="Cuerpo" type="RichTextLabel" parent="Mail/MailData"]
layout_mode = 0
offset_left = 48.0
offset_top = 74.0
offset_right = 470.0
offset_bottom = 566.0
theme_override_font_sizes/normal_font_size = 11
theme_override_font_sizes/bold_font_size = 11
theme_override_font_sizes/bold_italics_font_size = 11
theme_override_font_sizes/italics_font_size = 11
theme_override_font_sizes/mono_font_size = 11
bbcode_enabled = true
text = "Buenos días. Le escribe la comisaria Beatriz Luján.\n\nA las 08:10 de hoy, jueves 23/10, la jefa de limpieza del Hotel Mirador encontró muerto a Ramiro Salas, 58 años, huésped de la habitación 412. Tenía un golpe en la cabeza. El médico legista calcula que murió entre las 2 y las 3 de la madrugada.\n\nLa habitación no fue forzada: quien entró, entró con una tarjeta. Salas tenía la suya en la mesa de luz. Del sobre que había dejado en custodia a la noche, un millón de pesos, no hay rastro.\n\nYa tomamos declaración. El gerente nocturno, Esteban Vidal, dice que entre las 2 y las 3 estuvo todo el tiempo en recepción, haciendo el check-in de un huésped que llegó tarde. La jefa de limpieza admite que entró a la 412 a las once de la noche para reponer el minibar. La gerente general no quiso declarar sin su abogado. Y el socio de Salas le dejó un comentario amenazante en internet hace tres días.\n\nA mí la cosa no me cierra. El hotel nos cedió la computadora de recepción. Empiece por el libro de novedades del turno noche: ahí se anota todo lo que pasa.\n\nComisaria Beatriz Luján"

