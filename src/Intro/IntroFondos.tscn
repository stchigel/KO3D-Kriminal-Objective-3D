text = "Susana Ibarra"
vertical_alignment = 1

[node name="Cuerpo" type="RichTextLabel" parent="Mail/MailData" unique_id=541549091]
layout_mode = 0
offset_left = 48.0
offset_top = 74.0
offset_right = 470.0
offset_bottom = 566.0
theme_override_font_sizes/normal_font_size = 11
theme_override_font_sizes/bold_font_size = 11
theme_override_font_sizes/bold_italics_font_size = 11
theme_override_font_sizes/italics_font_size = 11
theme_override_font_sizes/mono_font_size = 11
bbcode_enabled = true
text = "Hola. Te escribe Susana Ibarra, directora del Instituto San Martín. Te pido absoluta reserva con lo que te voy a contar.\n\nAyer nos llamó la agencia Rumbo Sur, la que organiza el viaje de egresados del 5°B a Bariloche. Según ellos, de las tres cuotas que el curso dice haber pagado, a su cuenta llegó una sola. Son dos cuotas de todo el curso: más de dieciséis millones de pesos que no aparecen. Si no se resuelve antes de fin de mes, el viaje se cae.\n\nEn los pasillos ya encontraron culpable: Sofía Rey, la co-delegada, porque es la que junta el efectivo. Sus compañeros la miran raro y los padres de otros chicos me llaman para pedir que la suspenda. Yo la conozco desde primer grado y no me lo creo, pero tampoco puedo defenderla sin pruebas.\n\nTe dejé la compu de preceptoría, que es donde está todo lo del viaje. Empezá por el acta de la última reunión de padres, que la preceptora Méndez guardó en el escritorio. Ahí se habló de la plata.\n\nGracias por darnos una mano.\n\nSusana Ibarra — Directora"

