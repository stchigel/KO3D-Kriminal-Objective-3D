[node name="Cuerpo" type="RichTextLabel" parent="Mail/MailData" unique_id=541549091]
layout_mode = 0
offset_left = 48.0
offset_top = 74.0
offset_right = 470.0
offset_bottom = 566.0
theme_override_font_sizes/normal_font_size = 11
theme_override_font_sizes/bold_font_size = 11
theme_override_font_sizes/bold_italics_font_size = 11
theme_override_font_sizes/italics_font_size = 11
theme_override_font_sizes/mono_font_size = 11
bbcode_enabled = true
text = "Hola. Soy Lucía Ferro. Me dijeron que vos podías ayudarme, y la verdad es que ya no sé a quién más pedirle.\n\nEl sábado 15 volví de la facu a las cinco y media. Tenía todo preparado: a las seis venía un coleccionista a ver Agua quieta nº 3, el cuadro en el que trabajé cuatro meses, el que me iba a pagar un año de alquiler. Abrí la puerta y en la pared del living había un rectángulo vacío. Nada más. No faltaba otra cosa. No habían tocado ni la tele.\n\nLa policía vino y dijo lo que yo no quería escuchar: la cerradura no está forzada, así que entró alguien con llave. Llaves tenemos las tres que vivimos acá, Abril, Dana y yo. Y Omar, el encargado, que tiene copia de todas. Desde ese día en el depto nadie habla. Nos miramos raro. Abril llora, Dana se encierra en su cuarto, y yo no puedo dormir.\n\nLa compu del living la compartimos las tres, cada una con su usuario. No sé las claves de las chicas, ni ellas la mía. Entrá como Invitado: ahí están las reglas del depto que escribimos cuando nos mudamos. Por algo hay que empezar.\n\nPor favor.\n\nLu"

