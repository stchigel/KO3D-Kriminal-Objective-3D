[gd_resource type="Resource" script_class="Perfil" format=3]

[ext_resource type="Script" path="res://src/Perfiles/perfil.gd" id="perfil"]

[resource]
script = ExtResource("perfil")
nombre = "Federico Ale"
rol = "Sospechoso"
edad = "22"
ocupacion = "Revende zapatillas por redes"
vinculo = "Primo de Bruno"
notas = "Siempre tiene un negocio nuevo. Usa el mismo alias para todo."
final_al_acusar = "Se rastrea la cuenta de Federico, pero Bruno se desliga diciendo que fue engañado y sigue como delegado.\n\n[i]Gracias por intentarlo, agente.[/i]"
