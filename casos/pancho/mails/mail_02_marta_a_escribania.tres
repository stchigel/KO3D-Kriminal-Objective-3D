[gd_resource type="Resource" script_class="Mail" format=3]

[ext_resource type="Script" path="res://mail.gd" id="mail"]
[ext_resource type="Script" path="res://src/Expediente/pista.gd" id="pista"]

[sub_resource type="Resource" id="Pista_1"]
script = ExtResource("pista")
id = "mail_no_firma"
tipo = 0
titulo = "Marta se negó a firmar"
texto = "Marta le avisó a la escribanía que no iba a ir y que el turno lo sacó su sobrino sin consultarle."

[resource]
script = ExtResource("mail")
nombre = "Marta Ibáñez → Escribanía Paz"
asunto = "RE: Confirmación de turno"
mensaje = "Buenas tardes. Les escribo para avisarles que [url=mail_no_firma]no voy a ir. No firmo nada.[/url] El turno lo sacó mi sobrino sin consultarme. Disculpen la molestia y que tengan buena semana.\n\nMarta Ibáñez"
pistas = Array[ExtResource("pista")]([SubResource("Pista_1")])
