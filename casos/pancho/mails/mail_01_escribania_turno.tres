[gd_resource type="Resource" script_class="Mail" format=3]

[ext_resource type="Script" path="res://mail.gd" id="mail"]
[ext_resource type="Script" path="res://src/Expediente/pista.gd" id="pista"]

[sub_resource type="Resource" id="Pista_1"]
script = ExtResource("pista")
id = "mail_turno"
tipo = 0
titulo = "Turno en la escribanía"
texto = "La Escribanía Paz confirmó el turno del jueves 18/09 a las 10 hs para firmar un poder general a favor de Julián."

[resource]
script = ExtResource("mail")
nombre = "Escribanía Paz"
asunto = "Confirmación de turno"
mensaje = "Estimada Sra. Ibáñez:\n\nPor medio del presente le confirmamos su turno para el día [url=mail_turno]jueves 18/09 a las 10 hs[/url], a fin de proceder a la firma del poder general amplio a favor del Sr. Julián Ibáñez, según lo solicitado por el interesado.\n\nLe recordamos presentarse con DNI original y con quince minutos de anticipación. En caso de no poder asistir, le solicitamos avisar con al menos 24 horas.\n\nAtentamente,\n\nEscribanía Paz — Av. San Martín 2140"
pistas = Array[ExtResource("pista")]([SubResource("Pista_1")])
