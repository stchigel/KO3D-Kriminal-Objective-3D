[gd_resource type="Resource" script_class="Perfil" format=3]

[ext_resource type="Script" path="res://src/Perfiles/perfil.gd" id="perfil"]

[resource]
script = ExtResource("perfil")
nombre = "Marta Ibáñez"
rol = "Víctima"
edad = "68"
ocupacion = "Maestra jubilada"
vinculo = "Dueña de la notebook"
notas = "Vivía sola con su gato Pancho. Fue maestra de cuarto grado en la Escuela 14 de Villa Bosch durante treinta y dos años. Apareció al pie de la escalera el viernes 19; la policía dice que se cayó."
