[gd_resource type="Resource" script_class="Perfil" format=3]

[ext_resource type="Script" path="res://src/Perfiles/perfil.gd" id="perfil"]

[resource]
script = ExtResource("perfil")
nombre = "Julián Ibáñez"
rol = "Sospechoso"
edad = "34"
ocupacion = "Vendedor de autos usados en una agencia de Haedo"
vinculo = "Único sobrino de Marta"
notas = "El lunes va a mostrar la casa de Marta con una inmobiliaria."
es_culpable = true
pistas_de_cargo = PackedStringArray("mail_turno", "mail_no_firma", "carta_no_vender", "cam_llave_caida", "cam_llave_gancho", "cam_calendario")
puntos_necesarios = 7
pistas_obligatorias = PackedStringArray()
final_al_acusar = "Julián es detenido tras comprobarse que la llave era la suya y que intentó forzar la firma del poder. Nelly se queda con Pancho.\n\n[i]Buen trabajo, agente.[/i]"
final_sin_pruebas = "Julián fue acusado, pero las pruebas presentadas no alcanzaron para sostener el cargo y quedó en libertad. La casa de Marta terminó en venta.\n\n[i]Gracias por intentarlo, agente.[/i]"
