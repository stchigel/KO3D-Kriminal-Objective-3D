[gd_resource type="Resource" script_class="Perfil" format=3]

[ext_resource type="Script" path="res://src/Perfiles/perfil.gd" id="1_perfil"]

[resource]
script = ExtResource("1_perfil")
nombre = "Dante Ferreyra"
rol = "Sospechoso"
ocupacion = "Estudio Meridiano"
vinculo = "Contacto profesional de Vidal"
notas = "Pidió reunirse con Vidal en persona. Mail: dferreyra@estudiomeridiano.com.ar"
final_al_acusar = "Dante Ferreyra fue detenido y admitió su participación en el fraude, pero tenía coartada sólida para la noche de la muerte y ningún vínculo con el encargado del edificio. Fue condenado por la estafa, no por el homicidio. Lorenzo Machi, señalado solo tangencialmente, movió sus influencias y la causa por la muerte quedó caratulada como accidente. El verdadero asesino nunca respondió por Vidal."
