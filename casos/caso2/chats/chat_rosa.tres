mensajes_enviables = Array[String](["Rosa, soy la agente a cargo del caso. ¿Puedo hacerle algunas preguntas?", "¿Notó algo inusual en el departamento el lunes, el día antes de encontrarlo?", "¿El señor Vidal usaba la escalera interna habitualmente?"])
respuestas = Array[String](["Sí, faltante. Me lo dijeron esta mañana y todavía no puedo creer. Pregunte lo que quiera.", "El lunes no fui, tenía turno médico. Pero el viernes anterior sí noté algo raro: la notebook no estaba en su lugar de siempre, y había una taza de café sin lavar, cosa que él nunca dejaba.", "Nunca. Con la rodilla que tenía, siempre usaba el ascensor. Siempre. Por eso me llamó tanto la atención."])
metadata/_custom_type_script = "uid://by8r7fs8syfyj"
